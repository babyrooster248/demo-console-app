# Copy this file to `.claude/agent-knowledge.env` and fill in the two values your tech lead sends
# you. That copy is gitignored and never leaves your machine. One-time, and the only manual step
# this project asks of a member.
#
#   cp hooks/agent-knowledge.env.sample .claude/agent-knowledge.env
#
# Without it the hooks still run: they spool notes locally and say why, rather than failing
# silently, so a member who has not done this yet loses nothing except the sharing.

# The email your credential was issued for. It is also the identity the shared file counts you
# under, so the "(2 people)" marker means two credentials, not two guesses.
AGENT_KNOWLEDGE_USER=

# Issued by `node aggregator/make-credential.js <your-email>` and not recoverable from the server
# config, which stores only a hash. If you lose it, ask for a new one rather than for the old one.
AGENT_KNOWLEDGE_TOKEN=

# Only needed when the project's .claude/settings.json does not set it — which is the right choice
# when the repository is public, because the address of a write endpoint does not belong in a public
# git history. If settings.json already has it, leave this blank.
AGENT_KNOWLEDGE_INGEST=
